SITE_HOST=coreable-saf.com
WWW_SITE_HOST=www.coreable-saf.com

API_IMAGE=ghcr.io/jaekwang97/dropship-shop-api:latest
WEB_IMAGE=ghcr.io/jaekwang97/dropship-shop-web:latest

POSTGRES_DB=dropship_shop
POSTGRES_USER=dropship_shop
POSTGRES_PASSWORD=change-me

SMS_SENS_ENABLED=false
SMS_SENS_ACCESS_KEY=disabled
SMS_SENS_SECRET_KEY=disabled
SMS_SENS_SERVICE_ID=disabled
SMS_SENS_FROM_NUMBER=disabled

EMAIL_SES_ENABLED=false
EMAIL_SES_REGION=ap-northeast-2
EMAIL_FROM_ADDRESS=contact@coreable-saf.com
APP_PUBLIC_BASE_URL=https://coreable-saf.com
DROPSHIP_WEB_ORIGIN=https://coreable-saf.com
APP_INQUIRY_LOOKUP_SECRET=change-me-at-least-32-bytes-random
APP_SALES_ENABLED=false
APP_SUPPLIER_PORTAL_ENABLED=false
APP_SUPPLIER_PORTAL_HMAC_SECRET=change-me-at-least-32-bytes-random
APP_SUPPLIER_PORTAL_SUCCESS_REDIRECT_URI=https://coreable-saf.com/supplier

APP_BANK_TRANSFER_BANK_NAME=
APP_BANK_TRANSFER_ACCOUNT_NUMBER=
APP_BANK_TRANSFER_ACCOUNT_HOLDER=

DOMEGGOOK_PURCHASE_ENABLED=false
DOMEGGOOK_AUTO_ORDER_ENABLED=false
DOMEGGOOK_CATALOG_SYNC_ENABLED=false
DOMEGGOOK_CATALOG_SYNC_DRY_RUN=true
DOMEGGOOK_CATALOG_SYNC_BATCH_SIZE=20
DOMEGGOOK_CATALOG_SYNC_INTERVAL_MS=3600000
DOMEGGOOK_OPEN_API_KEY=
DOMEGGOOK_PURCHASE_USER_ID=
DOMEGGOOK_PURCHASE_USER_PASSWORD=
DOMEGGOOK_PURCHASE_CLIENT_IP=

APP_CORS_ALLOWED_ORIGINS=https://coreable-saf.com,https://www.coreable-saf.com
APP_INTERNAL_SYNC_TOKEN=change-me-long-random-token
APP_AUTH_JWT_SECRET=change-me-at-least-32-bytes-random
APP_AUTH_SUCCESS_REDIRECT_URI=https://coreable-saf.com/auth/callback/success

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=https://coreable-saf.com/api/auth/oauth2/google/callback
OAUTH_KAKAO_CLIENT_ID=
